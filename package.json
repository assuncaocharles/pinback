{
  "name": "preview-pins-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:example": "pnpm --filter @preview-pins/example-react-vite build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p e2e --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "build:example:e2e": "PREVIEW_PINS=1 PREVIEW_PINS_AUTH_ORIGIN=http://localhost:8787 pnpm --filter @preview-pins/example-react-vite build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "size-limit": "^14.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
