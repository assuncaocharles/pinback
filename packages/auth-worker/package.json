{
  "name": "@preview-pins/auth-worker",
  "version": "0.0.0",
  "description": "Stateless Cloudflare Worker: GitHub App OAuth code exchange and the auth iframe.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "vite": "^8.4.0",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "@preview-pins/core": "workspace:*"
  }
}
