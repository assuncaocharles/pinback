{
  "name": "@assuncaocharles/pinback-core",
  "version": "0.1.0",
  "description": "Framework-agnostic core for pinback: anchoring, comment metadata, threads and the GitHub backend.",
  "keywords": [
    "github",
    "pull-request",
    "code-review",
    "annotations",
    "anchoring"
  ],
  "homepage": "https://assuncaocharles.github.io/pinback/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assuncaocharles/pinback.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/assuncaocharles/pinback/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
