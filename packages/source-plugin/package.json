{
  "name": "@preview-pins/source-plugin",
  "version": "0.0.0",
  "description": "Vite plugin that tags JSX elements with data-pp-src in preview builds.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "vite": "^8.4.0"
  }
}
