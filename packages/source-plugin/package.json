{
  "name": "@assuncaocharles/pinback-source-plugin",
  "version": "0.0.0",
  "description": "Vite plugin that tags JSX elements with data-pp-src so pinback comments land on the right file and line.",
  "keywords": [
    "vite-plugin",
    "vite",
    "jsx",
    "react",
    "github",
    "code-review"
  ],
  "homepage": "https://assuncaocharles.github.io/pinback/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assuncaocharles/pinback.git",
    "directory": "packages/source-plugin"
  },
  "bugs": {
    "url": "https://github.com/assuncaocharles/pinback/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^8.1.3"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.20.7",
    "vite": "^8.4.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  }
}
