{
  "name": "@assuncaocharles/pinback",
  "version": "0.1.0",
  "description": "Pin review comments to any element on a preview deployment. Comments land on the GitHub PR. One script tag.",
  "keywords": [
    "github",
    "pull-request",
    "code-review",
    "preview",
    "deploy-preview",
    "comments",
    "web-component",
    "feedback"
  ],
  "homepage": "https://assuncaocharles.github.io/pinback/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assuncaocharles/pinback.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/assuncaocharles/pinback/issues"
  },
  "license": "MIT",
  "type": "module",
  "unpkg": "dist/pinback.js",
  "jsdelivr": "dist/pinback.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pinback.js": "./dist/pinback.js",
    "./pinback-capture.mjs": "./dist/pinback-capture.mjs"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/pinback.mjs"
      },
      "./pinback.js": "./dist/pinback.js",
      "./pinback-capture.mjs": "./dist/pinback-capture.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.capture.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@assuncaocharles/pinback-core": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.4.0",
    "modern-screenshot": "4.7.0"
  }
}
